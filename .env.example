# Public browser configuration. Never put a secret/service_role key in a VITE_* variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Enable only after configuring the real Google provider and redirect URLs in Supabase.
VITE_GOOGLE_OAUTH_ENABLED=false

# Canonical public origin. Preview deployments should retain the production canonical.
VITE_PUBLIC_SITE_URL=https://leadtrace-two.vercel.app
